{
  "recipe": {
    "name": "piney-dam-pipeline-example",
    "version": "1.0.0",
    "definition": {
      "recipe": [
        {
          "id": "reproject",
          "type": "REPROJECT_LAS",
          "required_params": ["source_epsg", "target_epsg"],
          "inputs": { "input_las": "input_las" },
          "outputs": ["output_las"]
        },
        {
          "id": "ept",
          "type": "BUILD_EPT",
          "inputs": { "input_las": "output_las" },
          "outputs": ["output_ept"]
        }
      ]
    }
  },
  "inputs": {
    "input_las": {
      "type": "las",
      "uri": "development/PINEY DAM MBES 1IN.laz",
      "hash": "abc123def456",
      "metadata": {}
    }
  },
  "params": {
    "reproject": { "source_epsg": "EPSG:2271", "target_epsg": "EPSG:3857" }
  },
  "outputs": { "output_ept": { "path": "final/piney-dam/ept" } }
}
