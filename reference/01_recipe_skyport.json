{
  "name": "agisoft-flight-ctm-tth-pipeline",
  "version": "2.0.0",
  "definition": {
    "recipe": [
      {
        "id": "agisoft",
        "type": "PROCESS_AGISOFT",
        "inputs": { "input_psx_zip": "job:input_psx_zip" },
        "outputs": {
          "output_orthomosaic_tif": "step:agisoft.output_orthomosaic_tif",
          "output_point_cloud_las": "step:agisoft.output_point_cloud_las"
        }
      },
      {
        "id": "process_point_cloud",
        "type": "PROCESS_POINT_CLOUD",
        "inputs": { "input_point_cloud": "step:agisoft.output_point_cloud_las" },
        "outputs": {
          "output_ctm_tif": "step:process_point_cloud.output_ctm_tif",
          "output_tth_shp": "step:process_point_cloud.output_tth_shp"
        }
      },
      {
        "id": "publish_flight",
        "type": "PUBLISH_FLIGHT_WMTS",
        "param_keys": ["workspace", "layer_name", "layer_title"],
        "inputs": { "input_tif": "step:agisoft.output_orthomosaic_tif" },
        "outputs": { "output_flight_cog_tif": "step:publish_flight.output_flight_cog_tif" }
      },
      {
        "id": "publish_ctm",
        "type": "PUBLISH_CTM_WMTS",
        "param_keys": ["workspace", "layer_name", "layer_title"],
        "inputs": { "input_tif": "step:process_point_cloud.output_ctm_tif" },
        "outputs": { "output_ctm_cog_tif": "step:publish_ctm.output_ctm_cog_tif" }
      },
      {
        "id": "publish_tth",
        "type": "PUBLISH_TTH_WMTS",
        "param_keys": ["workspace", "layer_name", "layer_title"],
        "inputs": { "input_shp_zip": "step:process_point_cloud.output_tth_shp" },
        "outputs": {}
      }
    ]
  }
}
